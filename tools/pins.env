# Pins that Dependabot cannot see, in one place: read by the scripts that
# use them, checked daily by the watchdog (tools/ci/pins.sh check). The Go
# minor version of the image must be the one in mise.toml. Same rules as
# any pin (CONTRIBUTING.md): at least 7 days old, by digest or exact
# version, listed in SECURITY.md.
GO_IMAGE=docker.io/library/golang:1.27.4-bookworm@sha256:fb7cceb528b47141eccd9b60bf3cbd27d5ef5f8cf5b7d338bec866da495b50dc
GOVULNCHECK=golang.org/x/vuln/cmd/govulncheck@v1.9.0
CYCLONEDX_GOMOD=github.com/CycloneDX/cyclonedx-gomod/cmd/cyclonedx-gomod@v1.12.0
OAPI_CODEGEN=github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@v2.8.2
